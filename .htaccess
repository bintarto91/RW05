Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Enforce HTTPS at the web server layer. This avoids CodeIgniter failing
    # to detect TLS correctly on shared-hosting proxy configurations.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteRule ^(app|system|vendor|writable|tests)(/.*)?$ - [F,L]
    RewriteRule ^(\.env|\.user\.ini|composer\.(json|lock)|spark|preload\.php|phpunit\.dist\.xml)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>
